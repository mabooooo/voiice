{
  "name": "voice-bridge-win",
  "private": true,
  "version": "0.0.31",
  "description": "Windows Electron bridge for voice-triggered whitelisted desktop actions.",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "build:renderer": "vite build --base=./",
    "start": "chcp 65001>nul && npm run build:renderer && electron .",
    "dev": "chcp 65001>nul && npm run build:renderer && electron .",
    "capability:omniparser:setup": "powershell -ExecutionPolicy Bypass -File ./capabilities/omniparser/setup.ps1",
    "capability:omniparser:start": "powershell -ExecutionPolicy Bypass -File ./capabilities/omniparser/start.ps1",
    "capability:ppocr:setup": "powershell -ExecutionPolicy Bypass -File ./capabilities/ppocr/setup.ps1",
    "capability:ppocr:start": "powershell -ExecutionPolicy Bypass -File ./capabilities/ppocr/start.ps1",
    "capability:sensevoice:setup": "powershell -ExecutionPolicy Bypass -File ./capabilities/sensevoice/setup.ps1",
    "capability:sensevoice:start": "powershell -ExecutionPolicy Bypass -File ./capabilities/sensevoice/start.ps1",
    "vendor:silero": "node ./scripts/download-silero-vad.mjs",
    "smoke:matcher": "node ./scripts/smoke-matcher.mjs",
    "smoke:screenshot": "electron ./scripts/smoke-screenshot.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron": "^41.2.0",
    "ffmpeg-static": "^5.3.0",
    "onnxruntime-web": "^1.20.1",
    "openai": "^6.34.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.9"
  }
}
